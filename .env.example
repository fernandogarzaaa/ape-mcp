# Environment variables read by APE. All are optional; set only what you need.
# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- Model providers ---
APE_PROVIDER=
APE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
APE_LOCAL_BASE_URL=
APE_NO_LOCAL=
APE_NEBIUS_BASE_URL=
APE_OPENCODE_BASE_URL=

# --- freepool (stacked free tiers; comma-separate several keys) ---
# Cost routing for provider:auto is opt-in: APE_COST_ROUTING=1
APE_COST_ROUTING=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HF_TOKEN=
OPENCODE_API_KEY=
APE_FREEPOOL_LOCAL_MODEL=
APE_FREEPOOL_MAX_ATTEMPTS=
APE_FREEPOOL_ATTEMPT_TIMEOUT_MS=
APE_FREEPOOL_CATALOG=

# --- Data & runtime ---
APE_DATA_DIR=
APE_PYTHON=
APE_MAX_CONCURRENT_RUNS=
APE_MAX_DAILY_USD=
APE_MAX_RESUMES=
APE_TASK_TTL_MS=
APE_WORKER_LOG_DAYS=
APE_FEEDBACK_THRESHOLD=
APE_CLAIM_AS=
APE_MCP_HEARTBEAT_MS=

# --- HTTP / MCP server & console ---
APE_HOST=
APE_PORT=
APE_CONSOLE_HOST=
APE_CONSOLE_PORT=
APE_CONSOLE_TOKEN=
APE_REQUIRE_AUTH=
APE_TOKENS=
APE_AUTH_SERVERS=
APE_ALLOWED_HOSTS=
APE_TRUSTED_PROXIES=
APE_CORS_ORIGIN=
APE_ALLOW_OPEN_REMOTE=
APE_ALLOW_PRIVATE_EGRESS=
APE_RATE_LIMIT_RPM=
APE_RATE_LIMIT_WINDOW_MS=

# --- Host integrations (config dirs of other agents) ---
APE_CLAUDE_HOME=
CODEX_HOME=
OPENCODE_HOME=

# --- ADAM binary ---
APE_ADAM_TAG=
APE_ADAM_SHA256=
APE_ADAM_BIN_DIR=
# Set to 1 only to run an ADAM binary whose checksum could not be verified.
APE_ADAM_ALLOW_UNVERIFIED=

# --- TUI ---
APE_TUI_BIN=
APE_TUI_FETCH_BASE=
APE_SKIP_TUI_DOWNLOAD=
APE_TUI_VERSION=
