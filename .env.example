# Environment variables read by APE. All are optional; set only what you need.
# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- Model providers ---
APE_PROVIDER=
APE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
APE_LOCAL_BASE_URL=
APE_NO_LOCAL=
APE_NEBIUS_BASE_URL=
APE_OPENCODE_BASE_URL=

# --- Data & runtime ---
APE_DATA_DIR=
APE_PYTHON=
APE_MAX_CONCURRENT_RUNS=
APE_MAX_DAILY_USD=
APE_MAX_RESUMES=
APE_TASK_TTL_MS=
APE_WORKER_LOG_DAYS=
APE_FEEDBACK_THRESHOLD=
APE_CLAIM_AS=
APE_MCP_HEARTBEAT_MS=

# --- HTTP / MCP server & console ---
APE_HOST=
APE_PORT=
APE_CONSOLE_HOST=
APE_CONSOLE_PORT=
APE_CONSOLE_TOKEN=
APE_REQUIRE_AUTH=
APE_TOKENS=
APE_AUTH_SERVERS=
APE_ALLOWED_HOSTS=
APE_CORS_ORIGIN=
APE_ALLOW_OPEN_REMOTE=
APE_ALLOW_PRIVATE_EGRESS=
APE_RATE_LIMIT_RPM=
APE_RATE_LIMIT_WINDOW_MS=

# --- Host integrations (config dirs of other agents) ---
APE_CLAUDE_HOME=
CODEX_HOME=
OPENCODE_HOME=

# --- ADAM binary download (scripts) ---
APE_ADAM_TAG=
APE_ADAM_SHA256=
APE_ADAM_REQUIRE_CHECKSUM=

# --- TUI ---
APE_TUI_BIN=
APE_TUI_FETCH_BASE=
APE_SKIP_TUI_DOWNLOAD=
APE_TUI_THEME=
APE_TUI_VERSION=
APE_MCP_JS=

# --- Testing only ---
APE_ALLOW_MOCK_INPUT=
APE_MOCK_STEP_DELAY_MS=
