{
  "name": "ape-mcp",
  "version": "1.0.0",
  "description": "APE — hybrid-native MCP server with an embedded, user-configurable agent: multi-engine orchestration (Genesis + EVE + ADAM + Skein), declarative connectors, task-graph execution, audit ledger, memory. No 5-repo clone required.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "bin": {
    "ape-mcp": "./bin/ape-mcp.js"
  },
  "main": "./src/index.js",
  "files": [
    "bin",
    "src",
    "console",
    "vendors",
    "skills",
    "schemas",
    "mods",
    "profiles",
    "connectors",
    "docs",
    "ape.config.example.yaml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "doctor": "node bin/ape-mcp.js doctor",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/ape.test.js tests/agent.test.js tests/connectors.test.js tests/extension.test.js",
    "console": "node bin/ape-mcp.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8",
    "yaml": "^2.4.0"
  },
  "mcp": {
    "protocolVersion": "2026-07-28",
    "server": { "name": "ape-mcp", "version": "1.0.0" }
  }
}