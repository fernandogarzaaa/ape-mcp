# npm packaging blacklist (applies on top of package.json "files").
# Vendored engine deps are installed by postinstall, never shipped.
node_modules
**/node_modules
vendors/eve/node_modules
vendors/genesis/node_modules
# Python caches
__pycache__
**/__pycache__
*.pyc
# Build outputs & caches (the prebuilt adam release binary is re-included below)
target
.venv
.eve-output
.skein
.fastembed_cache
.tmp-*/
# Repo tooling & CI (not shipped) — package.json "files" is the allowlist and
# wins for listed dirs, so this mostly guards non-listed paths. scripts/
# ships whole (postinstall + launcher fetch need their siblings). tui/
# sources are DELIBERATELY not shipped: npm crashes walking a local 900MB+
# tui/target on Windows, and cargo fallback needs a source checkout anyway.
scripts/*
!scripts/postinstall.mjs
tests
.vscode
.idea
# Logs & local state
*.log
adam_genome.json
adam_memory.db
*.db-wal
*.db-shm
vendor-report.json
*.tsbuildinfo
# Keep the prebuilt vendored ADAM release binary.
!vendors/adam/target/release/adam-mcp
!vendors/adam/target/release/adam-mcp.exe