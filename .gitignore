# Standalone prebuilt outputs ARE committed:
# `target/` ignores every dir named target; unignore the vendored chain so the
# prebuilt adam-mcp release binaries re-include (git can't re-include under an ignored parent).
!vendors/adam/target/
!vendors/adam/target/release/
!vendors/adam/target/release/adam-mcp.exe
!vendors/adam/target/release/adam-mcp
!vendors/genesis/dist/
!vendors/eve/dist/
