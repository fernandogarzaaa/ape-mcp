node_modules/
.ape/
.skein/
.fastembed_cache/
.tmp-*/
adam_genome.json
adam_memory.db
*.db
*.log
.eve-output/
target/
.venv/
__pycache__/
# ape-tui prebuilts are CI release artifacts, never source:
# built per platform by .github/workflows/tui-binaries.yml, fetched at
# install by scripts/postinstall.mjs, or built once locally by the launcher.
vendors/ape-tui/*/ape-tui
vendors/ape-tui/*/ape-tui.exe
# Standalone prebuilt outputs ARE committed:
# `target/` ignores every dir named target; re-include ONLY the vendored ADAM release
# binaries. Chain must re-include each parent dir before its children, then re-ignore
# the rest so build artifacts (debug/, deps/, .fingerprint/, ...) never enter git.
!vendors/adam/target/
vendors/adam/target/*
!vendors/adam/target/release/
vendors/adam/target/release/*
!vendors/adam/target/release/adam-mcp.exe
!vendors/adam/target/release/adam-mcp
!vendors/genesis/dist/
!vendors/eve/dist/

# Never commit real env files (only .env.example templates).
.env
.env.*
!.env.example
